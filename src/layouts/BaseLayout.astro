---
/* The frame every page sits in: <head>, top bar, menu, footer and the scripts that run on every page.
   Usage in a page:  <BaseLayout title="Approach" description="…"> …page content… </BaseLayout>
   Pages reached only through QR codes or outside links use FunnelLayout instead. */
import '../styles/main.scss';
import SiteHead from '../components/SiteHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page name shown in the browser tab, e.g. "Approach". Leave empty on the home page. */
  title?: string;
  /** Text search engines show under the link. */
  description?: string;
  /** Language of the page content ("es" for the Spanish forms). */
  lang?: 'en' | 'es';
}

const { title, description = site.description, lang = 'en' } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Patient capital`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead title={pageTitle} description={description} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
