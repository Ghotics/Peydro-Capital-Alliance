---
/* The frame every page sits in: <head>, top bar, menu, footer and the scripts that run on every page.
   Usage in a page:  <BaseLayout title="Approach" description="…"> …page content… </BaseLayout> */
import '../styles/main.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page name shown in the browser tab, e.g. "Approach". Leave empty on the home page. */
  title?: string;
  /** Text search engines show under the link. */
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Patient capital`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      /* Apply a saved Dark palette before the first paint, so pages don't flash Gold first.
         Keep the key in sync with src/scripts/global/theme.ts */
      try { if (localStorage.getItem('pca-palette') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
