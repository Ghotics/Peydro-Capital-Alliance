---
/* Quiénes somos — /quienes-somos */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { contactHref } from '../data/site';
import { url } from '../utils/url';
import '../styles/pages/quienes-somos.scss';

/* "Forma de trabajar": the four steps (icons are simple line drawings) */
const method = [
  { title: 'Entender', text: 'Conocer qué existe, qué falta y dónde hay potencial real.', icon: '<circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" />' },
  { title: 'Conectar', text: 'Encontrar complementariedades entre personas, empresas, activos, conocimiento y capacidades.', icon: '<circle cx="6" cy="12" r="3" /><circle cx="18" cy="6" r="3" /><circle cx="18" cy="18" r="3" /><path d="M8.7 10.7l6.6-3.4M8.7 13.3l6.6 3.4" />' },
  { title: 'Desarrollar', text: 'Convertir una combinación prometedora en una propuesta, iniciativa, proyecto o nueva capacidad.', icon: '<path d="M12 3l9 5-9 5-9-5 9-5z" /><path d="M3 13l9 5 9-5" />' },
  { title: 'Escalar', text: 'Sistematizar lo que funciona para que pueda crecer, repetirse y generar aprendizaje.', icon: '<path d="M4 19V5M4 19h16M8 15l3-4 3 2 4-6" />' },
];

/* "Arquitectura PCA": five areas in three groups */
const groups = [
  {
    label: 'Núcleo de escalabilidad',
    areas: [
      { name: 'OPUS', role: 'Crecimiento compuesto, desarrollo y escalado', text: 'Diseña, activa y escala nuevas formas de crecimiento alrededor de empresas, capacidades y ecosistemas. Detecta posibilidades, conecta recursos, desarrolla propuestas de valor, crea iniciativas y convierte lo que funciona en capacidades replicables.' },
      { name: 'PCA OS', role: 'Sistema operativo, datos y automatización', text: 'Organiza y conecta empresas, personas, capacidades, solicitudes, oportunidades, proyectos, documentación, trazabilidad, métricas y procesos para permitir que PCA funcione y escale.' },
    ],
  },
  {
    label: 'Conectada al núcleo',
    areas: [
      { name: 'LOGOS', role: 'Marca, comunicación, audiencia y captación', text: 'Convierte la actividad, el conocimiento y los resultados de PCA en contenido, reputación, visibilidad y nueva demanda.' },
    ],
  },
  {
    label: 'Áreas específicas',
    areas: [
      { name: 'GIZA', role: 'Alianzas, originación y referenciación', text: 'Desarrolla relaciones con negocios, comunidades y redes externas para detectar, generar y canalizar oportunidades hacia PCA.' },
      { name: 'NEXUS', role: 'Real Estate, activos y operaciones', text: 'Canaliza y estructura las oportunidades vinculadas a inmuebles, activos, operaciones y financiación asociada.' },
    ],
  },
];

const capable = [
  'Más capaz de detectar posibilidades.',
  'Más capaz de desarrollar propuestas de valor.',
  'Más capaz de combinar conocimiento.',
  'Más capaz de ejecutar.',
  'Y cada vez más capaz de escalar lo que funciona.',
];
---
<BaseLayout title="Quiénes somos" description="Peydró Capital Alliance construye arquitecturas que conectan personas, empresas, activos, conocimiento y relaciones para crear nuevas posibilidades de valor." lang="es">
  <PageHero
    eyebrow="Quiénes somos"
    lead="Peydró Capital Alliance parte de una convicción: muchas de las capacidades necesarias para generar crecimiento ya existen, pero suelen estar dispersas, desconectadas o infrautilizadas. Nuestra función es entenderlas, conectarlas y desarrollar alrededor de ellas estructuras capaces de producir y escalar valor."
    hint="Sigue leyendo"
  >Construimos arquitecturas para que las redes sean <span class="serif-em">más capaces</span>.</PageHero>

  <section class="sec">
    <div class="wrap about-intro reveal">
      <div>
        <span class="eyebrow">Qué es PCA</span>
        <h2 class="title">No somos una colección de <span class="serif-em">servicios</span>.</h2>
      </div>
      <div class="body">
        <p>PCA es una arquitectura de crecimiento que conecta personas, empresas, activos, conocimiento y relaciones para crear nuevas posibilidades de valor.</p>
        <p>No se limita a resolver una necesidad puntual: observa la red, detecta lo que puede combinarse y desarrolla estructuras que permiten que las oportunidades se multipliquen.</p>
      </div>
    </div>
  </section>

  <section class="sec alt-bg">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Forma de trabajar</span>
        <h2 class="title">Entender. Conectar.<br />Desarrollar. <span class="serif-em">Escalar.</span></h2>
      </div>
      <div class="cap-grid four">
        {method.map((step, i) => (
          <div class="cap reveal" data-delay={i || undefined}>
            <div class="idx">{String(i + 1).padStart(2, '0')}</div>
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={step.icon} />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Arquitectura PCA</span>
        <h2 class="title">Cinco áreas.</h2>
        <p class="lead">Funciones diferentes dentro de una misma arquitectura.</p>
      </div>
      {groups.map((group) => (
        <div class="area-group reveal">
          <div class="group-label">{group.label}</div>
          <div class="area-row">
            {group.areas.map((area) => (
              <div class="area">
                <div class="name">{area.name}</div>
                <div class="role">{area.role}</div>
                <p>{area.text}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="statement alt-bg">
    <div class="wrap reveal">
      <p class="big">No buscamos construir una red más grande. <span class="hl">Buscamos construir una red más capaz.</span></p>
      <ul class="capable-list">
        {capable.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div class="cta-box reveal">
        <h2>Hablemos</h2>
        <p>Cuéntanos qué necesitas o qué puedes aportar a la red. Te pondremos en contacto con la persona adecuada de PCA.</p>
        <a href={url(contactHref)} class="btn btn-primary">Solicitar reunión <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
