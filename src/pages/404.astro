---
/* Shown for any address that doesn't exist */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist.">
  <PageHero
    eyebrow="404"
    lead="The page you were looking for isn't here. It may have moved, or the link may be mistyped."
    hint="Or use the menu"
    compact
  >This page has <span class="serif-em">moved on</span>
    <Fragment slot="actions">
      <a href="/" class="btn btn-primary">Back to home <span class="arrow">→</span></a>
      <a href="/contact" class="btn btn-ghost">Contact us</a>
    </Fragment>
  </PageHero>
</BaseLayout>
