---
/* Crecimiento compuesto de redes — /crecimiento-compuesto */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { contactHref } from '../data/site';
import { url } from '../utils/url';
import '../styles/pages/crecimiento.scss';

/* "De red a ecosistema" */
const flow = ['Red', 'Conocimiento', 'Conexión', 'Activación', 'Valor'];

/* "Una arquitectura. Diferentes tipos de red." */
const ecosystems = [
  { title: 'Ecosistemas empresariales', text: 'Empresas, profesionales, expertos, proveedores, activos y conocimiento conectados para detectar necesidades, desarrollar propuestas de valor, generar colaboraciones y construir nuevas formas de crecimiento.', icon: '<rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 10h16M10 10v10" />', badge: '' },
  { title: 'Ecosistemas residenciales', text: 'Comunidades de propietarios, urbanizaciones, hogares, administradores, proveedores y servicios conectados alrededor de las necesidades reales de una comunidad y de las oportunidades de coordinación, eficiencia y valor compartido.', icon: '<path d="M4 20V9l8-6 8 6v11M4 20h16M9 20v-6h6v6" />', badge: '' },
  { title: 'Ecosistemas personales y patrimoniales', text: 'Personas, familias, patrimonio, profesionales de confianza, conocimiento y necesidades conectados dentro de una arquitectura coordinada.', icon: '<circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0 1 14 0M16 3.5a4 4 0 0 1 0 9M22 21a7 7 0 0 0-4-6.3" />', badge: 'En evolución' },
];

/* OPUS */
const opusSteps = [
  { title: 'Detectar', text: 'Escucha y analiza la red: qué necesita, qué puede aportar y dónde hay potencial.' },
  { title: 'Diseñar', text: 'Imagina nuevas combinaciones y desarrolla propuestas de valor alrededor de ellas.' },
  { title: 'Construir', text: 'Activa iniciativas concretas y mide lo que ocurre con cada una.' },
  { title: 'Escalar', text: 'Convierte los modelos que funcionan en activos replicables.' },
];
const opusLoop = ['Escuchar', 'Detectar', 'Conectar', 'Imaginar', 'Construir', 'Activar', 'Monetizar', 'Medir', 'Aprender', 'Replicar'];

/* PCA OS: what it organises */
const osData = ['Empresas', 'Personas', 'Capacidades', 'Solicitudes', 'Oportunidades', 'Proyectos', 'Documentos', 'Relaciones', 'Métricas', 'Procesos'];

/* El ciclo compuesto */
const cycle = [
  { title: 'Actividad', text: 'Cada nueva iniciativa, conexión o proyecto genera información.' },
  { title: 'Datos', text: 'PCA OS estructura esa información y le da trazabilidad.' },
  { title: 'Aprendizaje', text: 'OPUS utiliza ese aprendizaje para mejorar decisiones, propuestas e iniciativas.' },
  { title: 'Mejores propuestas', text: 'Cada iteración parte de más conocimiento que la anterior.' },
  { title: 'Nueva actividad', text: 'LOGOS puede amplificar lo que funciona y atraer nueva actividad a la red.' },
];

/* Modelo económico */
const revenue = ['Memberships', 'Fees', 'Proyectos', 'Comisiones', 'Revenue share', 'Patrocinios', 'Eventos', 'Implantaciones', 'Ventures', 'Operaciones sobre activos'];
---
<BaseLayout title="Crecimiento compuesto de redes" description="Cada nueva conexión aumenta lo que la red puede llegar a crear: así convierte PCA una red en un ecosistema que detecta, combina y escala valor." lang="es">
  <PageHero
    eyebrow="Crecimiento compuesto de redes"
    lead="Una red no crece únicamente porque incorpora más participantes. Crece porque cada nueva persona, empresa, activo, capacidad o relación aumenta las combinaciones posibles del conjunto."
    hint="Sigue leyendo"
  >Cada nueva conexión aumenta lo que la red <span class="serif-em">puede llegar a crear</span>.</PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="two-col reveal">
        <div>
          <span class="eyebrow">De red a ecosistema</span>
          <h2 class="title">Una red conecta participantes. <span class="serif-em">Un ecosistema activa capacidades.</span></h2>
        </div>
        <div class="body">
          <p>Una red se convierte en un ecosistema PCA cuando entendemos qué puede aportar cada participante, qué necesita, qué relaciones existen y qué nuevas posibilidades pueden construirse entre ellos.</p>
          <p>El valor no procede únicamente del tamaño de la red, sino de su capacidad para generar conexiones útiles, actividad, aprendizaje y nuevas formas de crecimiento.</p>
        </div>
      </div>
      <div class="flow reveal" aria-label="Red, conocimiento, conexión, activación, valor: ecosistemas PCA">
        {flow.map((step) => (
          <Fragment><span class="node">{step}</span><span class="arrow" aria-hidden="true">→</span></Fragment>
        ))}
        <span class="node end">Ecosistemas PCA</span>
      </div>
    </div>
  </section>

  <section class="sec alt-bg">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Ecosistemas PCA</span>
        <h2 class="title">Una arquitectura. <span class="serif-em">Diferentes tipos de red.</span></h2>
        <p class="lead">PCA puede desplegar su lógica de conexión, activación y crecimiento sobre redes de naturaleza distinta sin tener que rediseñar su arquitectura de base.</p>
      </div>
      <div class="cap-grid">
        {ecosystems.map((eco, i) => (
          <div class="cap reveal" data-delay={i || undefined}>
            {eco.badge && <span class="badge">{eco.badge}</span>}
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={eco.icon} />
            <h3>{eco.title}</h3>
            <p>{eco.text}</p>
          </div>
        ))}
      </div>
      <div class="two-col same-arch reveal">
        <h3>Cambia la red. <span class="serif-em">No cambia la arquitectura.</span></h3>
        <div class="body">
          <p>Cada ecosistema requiere una combinación distinta de capacidades, pero PCA mantiene una estructura común sobre la que puede desplegar nuevas implantaciones.</p>
          <p>La arquitectura se adapta al contexto, al tipo de participante y a las necesidades de la red, sin convertir cada nuevo ecosistema en una organización distinta.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="two-col reveal">
        <div>
          <span class="eyebrow">OPUS</span>
          <h2 class="title">La maquinaria de crecimiento compuesto de <span class="serif-em">PCA</span>.</h2>
        </div>
        <div class="body">
          <p>OPUS trabaja sobre empresas, capacidades y ecosistemas para detectar posibilidades de crecimiento, desarrollar nuevas propuestas de valor y convertir lo que funciona en modelos capaces de escalarse y replicarse.</p>
          <p>Puede generar conexiones, campañas, programas, productos, proyectos, nuevas líneas de negocio, experiencias, colaboraciones y otras iniciativas cuando tengan sentido.</p>
          <p>Su función no es esperar a que una necesidad llegue: es observar activamente la red, diseñar posibilidades y construir mecanismos para que el valor se multiplique.</p>
        </div>
      </div>
      <div class="cap-grid four after-text">
        {opusSteps.map((step, i) => (
          <div class="cap reveal" data-delay={i || undefined}>
            <div class="idx">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
      <ul class="loop reveal" aria-label="El ciclo de OPUS">
        {opusLoop.map((word) => <li>{word}</li>)}
        <li class="again" aria-hidden="true">↻</li>
      </ul>
    </div>
  </section>

  <section class="sec flush-top">
    <div class="wrap layers">
      <div class="layer reveal">
        <div class="name">PCA OS</div>
        <h3>La infraestructura operativa y de datos que permite escalar PCA.</h3>
        <p>PCA OS organiza y conecta la información de empresas, personas, capacidades, solicitudes, oportunidades, proyectos, documentos, relaciones, métricas y procesos.</p>
        <p>Su función es reducir dependencia de memoria dispersa, dar trazabilidad a la actividad y convertir lo que PCA aprende en una base operativa reutilizable.</p>
        <ul class="tags">
          {osData.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="layer reveal" data-delay="1">
        <div class="name">LOGOS</div>
        <h3>La actividad que genera PCA también puede convertirse en audiencia.</h3>
        <p>LOGOS transforma conocimiento, proyectos, casos, expertos, actividades y resultados en contenido, visibilidad, reputación y nueva demanda.</p>
        <p>A medida que OPUS genere más actividad, LOGOS puede convertirse en una capa cada vez más conectada a ese motor de crecimiento.</p>
        <div class="flow compact" aria-label="OPUS, LOGOS: audiencia, reputación, nueva demanda">
          <span class="node">OPUS</span><span class="arrow" aria-hidden="true">→</span><span class="node">LOGOS</span><span class="arrow" aria-hidden="true">→</span><span class="node end">Audiencia · Reputación · Nueva demanda</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec alt-bg">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">El ciclo compuesto</span>
        <h2 class="title">La red no solo crece. <span class="serif-em">Aprende.</span></h2>
      </div>
      <div class="steps" id="steps">
        <div class="rail"><div class="fill" id="railFill"></div></div>
        {cycle.map((step, i) => (
          <div class="step reveal"><div class="bullet">{i + 1}</div><div><h3>{step.title}</h3><p>{step.text}</p></div></div>
        ))}
      </div>
      <p class="cycle-end reveal">El resultado es una red con cada vez más capacidad para detectar, combinar y escalar valor.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Modelo económico</span>
        <h2 class="title">Crear valor también exige <span class="serif-em">saber cómo capturarlo</span>.</h2>
        <p class="lead">PCA puede monetizar de formas distintas según la naturaleza de cada iniciativa:</p>
      </div>
      <ul class="tags big reveal">
        {revenue.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div class="cta-box reveal">
        <span class="eyebrow">Hablemos de tu red</span>
        <h2>Cada conexión que entra multiplica lo que la red puede crear.</h2>
        <p>Cuéntanos sobre tu red y veamos juntos qué puede llegar a crear.</p>
        <a href={url(contactHref)} class="btn btn-primary">Solicitar reunión <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <script>import '../scripts/pages/crecimiento';</script>
</BaseLayout>
