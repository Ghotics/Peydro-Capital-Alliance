---
/* Everything inside <head>, shared by both layouts (BaseLayout and FunnelLayout). */
interface Props {
  /** Full text for the browser tab. */
  title: string;
  description: string;
  /** Keep the page out of Google and other search engines (QR-only pages). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<script is:inline>
  /* Apply a saved Dark palette before the first paint, so pages don't flash Gold first.
     Keep the key in sync with src/scripts/global/theme.ts */
  try { if (localStorage.getItem('pca-palette') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
