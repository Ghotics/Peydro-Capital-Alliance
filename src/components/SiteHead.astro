---
/* Everything inside <head>, shared by both layouts (BaseLayout and FunnelLayout). */
import { url } from '../utils/url';

interface Props {
  /** Full text for the browser tab. */
  title: string;
  description: string;
  /** Keep the page out of Google and other search engines (QR-only pages). */
  noindex?: boolean;
  /** The same page in each language, for search engines (hreflang). */
  alternates?: { lang: string; path: string }[];
}

const { title, description, noindex = false, alternates = [] } = Astro.props;
/* hreflang links must be full addresses, so they're only added when the site address is known (on GitHub Pages) */
const absolute = (path: string) => (Astro.site ? new URL(url(path), Astro.site).href : null);
const langLinks = alternates.map((a) => ({ ...a, href: absolute(a.path) })).filter((a) => a.href);
const defaultLink = langLinks.find((a) => a.lang === 'es');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{langLinks.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{defaultLink && <link rel="alternate" hreflang="x-default" href={defaultLink.href} />}
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<script is:inline>
  /* Apply a saved Dark palette before the first paint, so pages don't flash Gold first.
     Keep the key in sync with src/scripts/global/theme.ts */
  try { if (localStorage.getItem('pca-palette') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
