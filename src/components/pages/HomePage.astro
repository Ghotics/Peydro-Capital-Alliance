---
/* Home page layout, shared by both languages. Texts: src/i18n/pages/home.ts
   Routes: src/pages/index.astro (es) and src/pages/en/index.astro (en) */
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/config';
import { pathFor } from '../../i18n/routes';
import { home } from '../../i18n/pages/home';
import { url } from '../../utils/url';
import '../../styles/pages/home.scss';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
---
<BaseLayout lang={lang} page="home" description={t.description}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><div class="orb a" data-depth="0.20"></div><div class="orb b" data-depth="0.12"></div><div class="orb c" data-depth="0.28"></div></div>
    <div class="wrap hero-content">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1>{t.hero.titleLines.map((line) => <span class="line"><span set:html={line} /></span>)}</h1>
      <p class="intro">{t.hero.lead}</p>
      <div class="hero-actions">
        <a href={url(pathFor('giza', lang))} class="btn btn-primary">{t.hero.button} <span class="arrow">→</span></a>
      </div>
    </div>
    <button class="scroll-cue" id="scrollCue" type="button"><span>{t.hero.scroll}</span><span class="dotline"></span></button>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="two-col reveal">
        <div>
          <span class="eyebrow">{t.capital.eyebrow}</span>
          <h2 class="title" set:html={t.capital.title} />
        </div>
        <div class="body">
          {t.capital.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <ul class="tags big capitals reveal" aria-label={t.capital.kindsLabel}>
        {t.capital.kinds.map((kind) => <li>{kind}</li>)}
      </ul>
    </div>
  </section>

  <section class="sec alt-bg">
    <div class="wrap">
      <div class="two-col reveal">
        <div>
          <span class="eyebrow">{t.why.eyebrow}</span>
          <h2 class="title" set:html={t.why.title} />
        </div>
        <div class="body">
          {t.why.paragraphs.map((p, i) => <p class:list={[{ strong: i === t.why.strong }]}>{p}</p>)}
        </div>
      </div>
      <div class="flow reveal" aria-label={[...t.why.flow, t.why.flowEnd].join(' → ')}>
        {t.why.flow.map((step) => (
          <Fragment><span class="node">{step}</span><span class="arrow" aria-hidden="true">→</span></Fragment>
        ))}
        <span class="node end">{t.why.flowEnd}</span>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{t.architecture.eyebrow}</span>
        <h2 class="title" set:html={t.architecture.title} />
        <p class="lead">{t.architecture.lead}</p>
      </div>
      {t.architecture.groups.map((group) => (
        <div class="area-group reveal">
          <div class="group-label">{group.label}</div>
          <div class="area-row">
            {group.areas.map((area) => (
              <div class="area">
                <div class="name">{area.name}</div>
                <div class="role">{area.role}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="arch-link reveal"><a href={url(pathFor('growth', lang))} class="btn btn-ghost">{t.architecture.link} <span class="arrow">→</span></a></p>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div class="cta-box reveal">
        <h2>{t.cta.title}</h2>
        <p>{t.cta.text}</p>
        <a href={url(pathFor('giza', lang))} class="btn btn-primary">{t.cta.button} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <script>import '../../scripts/pages/home';</script>
</BaseLayout>
