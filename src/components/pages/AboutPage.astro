---
/* Quiénes somos / About us page layout, shared by both languages. Texts: src/i18n/pages/about.ts
   Routes: src/pages/quienes-somos.astro (es) and src/pages/en/about.astro (en) */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import type { Lang } from '../../i18n/config';
import { pathFor } from '../../i18n/routes';
import { about } from '../../i18n/pages/about';
import { ui } from '../../i18n/ui';
import { url } from '../../utils/url';
import '../../styles/pages/quienes-somos.scss';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = about[lang];

---
<BaseLayout lang={lang} page="about" title={t.title} description={t.description}>
  <PageHero eyebrow={t.hero.eyebrow} lead={t.hero.lead} hint={ui[lang].keepScrolling}><Fragment set:html={t.hero.title} /></PageHero>

  <section class="sec">
    <div class="wrap about-intro reveal">
      <div>
        <span class="eyebrow">{t.intro.eyebrow}</span>
        <h2 class="title" set:html={t.intro.title} />
      </div>
      <div class="body">
        {t.intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="sec alt-bg" id="method">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{t.method.eyebrow}</span>
        <h2 class="title" set:html={t.method.title} />
      </div>
      {/* numbered steps on a line that fills as you scroll: styles/components/_process-steps.scss */}
      <div class="steps" id="steps">
        <div class="rail"><div class="fill" id="railFill"></div></div>
        {t.method.steps.map((step, i) => (
          <div class="step reveal"><div class="bullet">{i + 1}</div><div><h3>{step.title}</h3><p>{step.text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{t.architecture.eyebrow}</span>
        <h2 class="title">{t.architecture.title}</h2>
        <p class="lead">{t.architecture.lead}</p>
      </div>
      {t.architecture.groups.map((group) => (
        <div class="area-group reveal">
          <div class="group-label">{group.label}</div>
          <div class="area-row">
            {group.areas.map((area) => (
              <div class="area">
                <div class="name">{area.name}</div>
                <div class="role">{area.role}</div>
                <p>{area.text}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="statement alt-bg">
    <div class="wrap reveal">
      <p class="big" set:html={t.statement} />
      <ul class="capable-list">
        {t.capable.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div class="cta-box reveal">
        <h2>{t.cta.title}</h2>
        <p>{t.cta.text}</p>
        <a href={url(pathFor('giza', lang))} class="btn btn-primary">{t.cta.button} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <script>import '../../scripts/pages/about';</script>
</BaseLayout>
