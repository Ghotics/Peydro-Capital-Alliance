---
/* Small line icons for the forms and the Business Office page.
   Usage:  <FormIcon name="shield" />   (names are listed in IconName, src/data/forms.ts) */
import type { IconName } from '../../data/forms';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'ficon' } = Astro.props;

const paths: Record<IconName, string> = {
  shield: 'M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z M9 12l2 2 4-4',
  laptop: 'M5 6h14v9H5z M3 18h18 M10 18l.5-1h3l.5 1',
  antenna: 'M12 11v10 M9 21h6 M8.5 7.5a5 5 0 0 1 7 0 M6 5a8.5 8.5 0 0 1 12 0 M12 11a1 1 0 1 0 0-.01',
  megaphone: 'M4 10v4h3l7 4V6l-7 4H4z M17 9.5a3.5 3.5 0 0 1 0 5 M7 14l1 5h2.5l-1-5',
  chat: 'M4 5h16v11H9l-5 4V5z M8 9h8 M8 12h5',
  form: 'M6 3h9l3 3v15H6z M9 10h6 M9 14h6 M9 18h3',
  calendar: 'M4 6h16v14H4z M4 10h16 M8 3v5 M16 3v5 M8 14h2 M12 14h2',
  handshake: 'M3 11l4-4 4 2 3-2 3 1 4 3 M3 11l5 5 2-1 2 2 2-1 2 1 5-5 M11 9l-2 3 2 1 3-3',
};
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
</svg>
