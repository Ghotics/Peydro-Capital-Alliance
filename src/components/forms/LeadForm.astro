---
/* One lead form card: a single page of contact details, then the screens shown after sending.
   All three intake forms use this component; the props decide which fields appear.
     <LeadForm kind="business_office" area="tecnologia" askBuilding booking calLink="" />
   Behaviour: src/scripts/forms/lead-form.ts  ·  Styles: src/styles/components/_lead-form.scss
   Texts: src/i18n/forms.ts (Spanish by default; the Giza form passes lang="en" on English pages).

   The field names (first_name, email, building…) are the names the database columns will have,
   so what the form collects and what gets saved line up one to one — in either language. */
import type { FormKind } from '../../data/forms';
import { buildings } from '../../data/forms';
import type { Lang } from '../../i18n/config';
import { formTexts } from '../../i18n/forms';
import { pathFor } from '../../i18n/routes';
import { url } from '../../utils/url';
import PrivacyNotice from './PrivacyNotice.astro';

interface Props {
  kind: FormKind;
  /** Language of the texts. Spanish by default. */
  lang?: Lang;
  /** Department slug, saved with the lead (Business Office only). */
  area?: string;
  /** Ask for the Renta 92 building and unit number (Business Office). */
  askBuilding?: boolean;
  /** Heading and intro above the fields. */
  title?: string;
  intro?: string;
  /** The message box is always optional. */
  messageLabel?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
  /** Offer to book a meeting after sending. */
  booking?: boolean;
  /** Cal.com page for that booking ('' = not connected yet). */
  calLink?: string;
  /** Who the meeting is with, e.g. "Irene" or "el especialista de tu departamento". */
  bookingWith?: string;
  /** The "← Volver a …" link under the form. Plain site paths ('/asesoramiento'); the sub-folder is added here. */
  backHref?: string;
  backLabel?: string;
  /** Where the button on the last screen goes. */
  homeHref?: string;
  homeLabel?: string;
}

const lang: Lang = Astro.props.lang ?? 'es';
const t = formTexts[lang];
const {
  kind,
  area = '',
  askBuilding = false,
  title = t.title,
  intro = t.intro,
  messageLabel = t.messageLabel,
  messagePlaceholder = t.messagePlaceholder,
  submitLabel = t.submitLabel,
  booking = false,
  calLink = '',
  bookingWith = t.bookingWith,
  backHref,
  backLabel = t.backLabel,
  homeHref = pathFor('home', lang),
  homeLabel = t.homeLabel,
} = Astro.props;

const backLink = backHref ? url(backHref) : undefined;
const homeLink = url(homeHref);
const privacyLink = url(pathFor('privacy', lang));
const id = `lf-${kind}${area ? `-${area}` : ''}`;
---
<div class="lead-form" data-lead-form data-kind={kind} data-area={area} data-cal={calLink}>
  <form class="lf-form" novalidate>
    <section class="lf-step on" data-step="contact" aria-labelledby={`${id}-t2`}>
      <h2 class="lf-title" id={`${id}-t2`} tabindex="-1">{title}</h2>
      <p class="lf-sub">{intro}</p>

      <div class="two">
        <div class="field" data-field="first_name">
          <label for={`${id}-first_name`}>{t.firstName} <span class="req" aria-hidden="true">*</span></label>
          <input id={`${id}-first_name`} name="first_name" type="text" autocomplete="given-name" placeholder={t.firstNamePlaceholder} maxlength="80" required />
          <div class="msg">{t.firstNameError}</div>
        </div>
        <div class="field" data-field="last_name">
          <label for={`${id}-last_name`}>{t.lastName} <span class="req" aria-hidden="true">*</span></label>
          <input id={`${id}-last_name`} name="last_name" type="text" autocomplete="family-name" placeholder={t.lastNamePlaceholder} maxlength="120" required />
          <div class="msg">{t.lastNameError}</div>
        </div>
      </div>

      <div class="two">
        <div class="field" data-field="email">
          <label for={`${id}-email`}>{t.email} <span class="req" aria-hidden="true">*</span></label>
          <input id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email" placeholder={t.emailPlaceholder} maxlength="160" required />
          <div class="msg">{t.emailError}</div>
        </div>
        <div class="field" data-field="phone">
          <label for={`${id}-phone`}>{t.phone} <span class="req" aria-hidden="true">*</span></label>
          <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+34 600 000 000" maxlength="25" required />
          <div class="msg">{t.phoneError}</div>
        </div>
      </div>

      {askBuilding && (
        <div class="two">
          <div class="field" data-field="building">
            <label for={`${id}-building`}>{t.building} <span class="req" aria-hidden="true">*</span></label>
            <select id={`${id}-building`} name="building" required>
              <option value="">{t.buildingSelect}</option>
              {buildings.map((b) => <option value={b}>{t.buildingOption} {b}</option>)}
            </select>
            <div class="msg">{t.buildingError}</div>
          </div>
          <div class="field" data-field="unit">
            <label for={`${id}-unit`}>{t.unit} <span class="req" aria-hidden="true">*</span></label>
            <input id={`${id}-unit`} name="unit" type="text" placeholder={t.unitPlaceholder} maxlength="20" required />
            <div class="msg">{t.unitError}</div>
          </div>
        </div>
      )}

      <div class="field" data-field="message">
        <label for={`${id}-message`}>{messageLabel} <span class="opt">{t.optional}</span></label>
        <textarea id={`${id}-message`} name="message" rows="4" maxlength="2000" placeholder={messagePlaceholder}></textarea>
      </div>

      {/* Hidden trap for spam bots: people never see or fill it, bots usually do. */}
      <div class="lf-hp" aria-hidden="true">
        <label>{t.honeypot} <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="lf-check" data-field="privacy">
        <label class="lf-consent">
          <input type="checkbox" name="privacy" required />
          <span>{t.consentBefore} <a href={privacyLink} target="_blank" rel="noopener">{t.consentLink}</a> {t.consentAfter} <span class="req" aria-hidden="true">*</span></span>
        </label>
        <div class="msg">{t.consentError}</div>
      </div>

      <PrivacyNotice lang={lang} />

      <div class="lf-alert" role="alert" data-send-error hidden>{t.sendError}</div>

      <div class="lf-foot">
        {backLink ? <a class="lf-back" href={backLink}>← {backLabel}</a> : <span></span>}
        <button type="submit" class="btn btn-primary" data-submit data-sending-label={t.sending}><span data-label>{submitLabel}</span> <span class="arrow">→</span></button>
      </div>
      <p class="lf-note" data-demo hidden>{t.demoNote}</p>
    </section>
  </form>

  <section class="lf-step lf-done" data-step="done" aria-labelledby={`${id}-t3`}>
    <div class="lf-done-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" /></svg></div>
    <span class="lf-pill">{booking ? t.donePillBooking : t.donePill}</span>
    <h2 class="lf-title" id={`${id}-t3`} tabindex="-1">{t.doneTitle}</h2>
    {booking ? (
      <>
        <p class="lf-sub">{t.doneBookingText.replace('{who}', bookingWith)}</p>
        <div class="lf-actions">
          <button type="button" class="btn btn-primary" data-book>{t.book} <span class="arrow">→</span></button>
          <button type="button" class="btn btn-ghost" data-finish>{t.finish}</button>
        </div>
        <p class="lf-info" data-cal-opened hidden>{t.calOpened}</p>
        <p class="lf-info" data-cal-missing hidden>{t.calMissing}</p>
        <p class="lf-info">{t.calInfo}</p>
      </>
    ) : (
      <>
        <p class="lf-sub">{t.doneText}</p>
        <div class="lf-actions"><a class="btn btn-ghost" href={homeLink}>{homeLabel}</a></div>
      </>
    )}
    <p class="lf-note">{t.confirmationTo} <strong data-echo="email"></strong>.</p>
  </section>

  {booking && (
    <section class="lf-step lf-done" data-step="finished" aria-labelledby={`${id}-t4`}>
      <div class="lf-done-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" /></svg></div>
      <h2 class="lf-title" id={`${id}-t4`} tabindex="-1">{t.thanks} <span data-echo="first_name"></span></h2>
      <p class="lf-sub">{t.finishedText}</p>
      <div class="lf-actions"><a class="btn btn-ghost" href={homeLink}>{homeLabel}</a></div>
    </section>
  )}
</div>
