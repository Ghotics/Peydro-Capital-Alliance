---
/* The short data-protection notice shown inside every form ("primera capa" in the AEPD's wording).
   The law asks for this basic information at the moment the data is collected; the full detail
   ("segunda capa") is the privacy page, in the same language.
   Texts: src/i18n/forms.ts (privacy) and src/data/legal.ts  ·  Styles: _lead-form.scss (.lf-privacy) */
import Fill from '../legal/Fill.astro';
import { controller } from '../../data/legal';
import type { Lang } from '../../i18n/config';
import { formTexts } from '../../i18n/forms';
import { pathFor } from '../../i18n/routes';
import { url } from '../../utils/url';

interface Props {
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? 'es';
const t = formTexts[lang].privacy;
---
<div class="lf-privacy">
  <p class="lf-privacy-title">{t.title}</p>
  <dl>
    <div><dt>{t.controller}</dt><dd><Fill value={controller.name} /></dd></div>
    <div><dt>{t.purpose}</dt><dd>{t.purposeText}</dd></div>
    <div><dt>{t.basis}</dt><dd>{t.basisText}</dd></div>
    <div><dt>{t.recipients}</dt><dd>{t.recipientsText}</dd></div>
    <div><dt>{t.rights}</dt><dd>{t.rightsBefore} <a href={url(pathFor('privacy', lang))} target="_blank" rel="noopener">{t.rightsLink}</a>.</dd></div>
  </dl>
</div>
