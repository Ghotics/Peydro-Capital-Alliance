---
/* Site footer. Styles: src/styles/components/_footer.scss */
import Brand from './Brand.astro';
import { site } from '../data/site';
import type { Lang } from '../i18n/config';
import { mainNav, pathFor } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { url } from '../utils/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const f = t.footer;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <Brand lang={lang} />
        <p>{f.tagline}</p>
      </div>
      <div>
        <h5>{f.firm}</h5>
        {mainNav.map((key) => <a href={url(pathFor(key, lang))}>{t.nav[key]}</a>)}
      </div>
      <div>
        <h5>{f.company}</h5>
        <a href={url(pathFor('giza', lang))}>{f.contact}</a>
        <a href={url(pathFor('giza', lang))}>{t.investorLogin}</a>
        <a href={url(pathFor('home', lang))}>{f.home}</a>
      </div>
      <div>
        <h5>{f.legal}</h5>
        <a href={url(pathFor('legalNotice', lang))}>{f.legalNotice}</a>
        <a href={url(pathFor('terms', lang))}>{f.terms}</a>
        <a href={url(pathFor('privacy', lang))}>{f.privacy}</a>
        <a href={url(pathFor('disclosures', lang))}>{f.disclosures}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {site.name}.</span>
      <a href="#top" class="to-top">{f.toTop}</a>
    </div>
  </div>
</footer>
